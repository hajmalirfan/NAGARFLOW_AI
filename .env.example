POSTGRES_DB=nagarflow
POSTGRES_USER=nagarflow
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://nagarflow:change-this-local-password@127.0.0.1:5433/nagarflow
JWT_SECRET_KEY=replace-this-with-a-long-random-secret-before-deploy

# Password reset
RESET_TOKEN_EXPIRE_MINUTES=15
# Where reset links point. Must be the address the user's browser opens.
FRONTEND_BASE_URL=http://localhost:5173

# Outgoing email. Leave SMTP_HOST empty for local development: the API
# then writes each message to backend/dev_emails/ and logs the reset link
# instead of sending real email. Fill these in to send real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=NagarFlow <no-reply@nagarflow.local>
