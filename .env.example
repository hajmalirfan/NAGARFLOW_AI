POSTGRES_DB=nagarflow
POSTGRES_USER=nagarflow
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://nagarflow:change-this-local-password@127.0.0.1:5433/nagarflow
JWT_SECRET_KEY=replace-this-with-a-long-random-secret-before-deploy

# Anything but development refuses this placeholder secret, turns off the API
# docs and sends Strict-Transport-Security.
ENVIRONMENT=development

# Road network. The dataset is local only and is not committed; leave
# ROAD_NETWORK_PATH empty and scenarios stay incomplete. ROAD_SNAP_MAX_M is
# how far a location may sit from a road, and is an assumption, not a
# measured figure.
ROAD_NETWORK_PATH=docs/dataset/planet_78.163_11.047_55136793-geopackage/planet_78.163_11.047_55136793.gpkg
ROAD_SNAP_MAX_M=200
# How long OR-Tools may search, in seconds. It always uses the whole limit.
OPTIMIZER_TIME_LIMIT_S=10

# Password reset
RESET_TOKEN_EXPIRE_MINUTES=15
# Where reset links point. Must be the address the user's browser opens.
FRONTEND_BASE_URL=http://localhost:5173

# Outgoing email. Leave SMTP_HOST empty for local development: the API
# then writes each message to backend/dev_emails/ and logs the reset link
# instead of sending real email. Fill these in to send real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=NagarFlow <no-reply@nagarflow.local>
