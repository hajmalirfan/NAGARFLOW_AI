# Settings for docker-compose.prod.yml. Copy to .env.production, replace every
# placeholder, and never commit the copy. The server refuses to start while
# any of the checked values below still looks like a local or example value.

# Database. The password must not be the example one.
POSTGRES_DB=nagarflow
POSTGRES_USER=nagarflow
POSTGRES_PASSWORD=replace-with-a-private-database-password
DATABASE_URL=postgresql+psycopg://nagarflow:replace-with-a-private-database-password@db:5432/nagarflow

# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-generated-secret

# The address people open in their browser. Neither may be localhost.
CORS_ORIGINS=["https://nagarflow.example.org"]
FRONTEND_BASE_URL=https://nagarflow.example.org
# Where the browser reaches the API. Baked into the frontend when it is built.
API_ORIGIN=https://api.nagarflow.example.org

# Password reset email. SMTP_HOST is required in production.
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USERNAME=replace-with-the-smtp-user
SMTP_PASSWORD=replace-with-the-smtp-password
SMTP_USE_TLS=true
EMAIL_FROM=NagarFlow <no-reply@nagarflow.example.org>

# The OpenStreetMap GeoPackage on the host. It is mounted read-only and is never
# copied into an image.
ROAD_NETWORK_HOST_PATH=/srv/nagarflow/roads.gpkg
ROAD_SNAP_MAX_M=200

# Optimizer. Each run uses one CPU core for its time limit.
OPTIMIZER_TIME_LIMIT_S=10
OPTIMIZER_MAX_CONCURRENT=2

# How many proxies sit in front of the backend and add X-Forwarded-For. Leave at
# 0 unless one does, or clients could choose their own address.
TRUSTED_PROXY_HOPS=1
